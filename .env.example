# ---------------------------------------------------------------------------
# DZ Video AI Studio — environment template
#
# Copy to `.env.local` and fill in. `.env.local` is git-ignored; never commit it,
# and never prefix a secret with NEXT_PUBLIC_ — anything with that prefix is
# inlined into the client bundle by design.
# ---------------------------------------------------------------------------

# --- AI (server-side only) -------------------------------------------------
# Google AI Studio key. Used by /api/ai/*. Without it the app still works end to
# end: transcription runs on-device where the browser supports it and clip
# suggestions are measured from the transcript instead of ranked by a model.
GEMINI_API_KEY=
# Preferred model, then a ladder the client falls down on capacity errors.
GEMINI_MODEL=gemini-flash-latest
GEMINI_MODEL_FALLBACKS=gemini-3.8-flash,gemini-3.7-flash,gemini-flash-lite-latest
# Dedicated audio-transcription model.
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
# Salt for hashing client identities in the quota limiter (any random string).
AI_QUOTA_SALT=

# --- Quran Foundation Content API -----------------------------------------
# Server-only credentials (OAuth2 client credentials). The canonical text is
# cached in `src/lib/quran/fixture.json`, so the app runs without these; they are
# needed to refresh or widen the corpus.
QURAN_CLIENT_ID=
QURAN_CLIENT_SECRET=
QURAN_API_BASE=https://api.quran.com/api/v4

# --- Supabase (Postgres + Auth) -------------------------------------------
# Metadata only: projects, transcripts, settings, usage, subscriptions.
# Media never goes here. RLS is mandatory on every table.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Rate limiting / cache (multi-instance) --------------------------------
# When present, the AI limiter and response cache use Redis instead of the
# in-process store. Both are optional for single-instance deployments.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Payments --------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Chargily Pay — local Algerian rail (CIB / Edahabia).
CHARGILY_SECRET_KEY=
CHARGILY_PUBLIC_KEY=
CHARGILY_WEBHOOK_SECRET=

# --- Observability ---------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3111
